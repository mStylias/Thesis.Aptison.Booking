<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.69.24" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Infrastructure carries the migration .sql files as Content, and content items flow to a
      referencing project's output — which is what puts them under this assembly's
      Persistence\Migrations for DatabaseMigrationRunner to find.
    -->
    <ProjectReference Include="..\..\..\src\Aptison.Booking.Infrastructure\Aptison.Booking.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Aptison.Booking.Tests.Common\Aptison.Booking.Tests.Common.csproj" />
    <!-- For EndpointPermissionGuard's rules. Nothing here boots the host. -->
    <ProjectReference Include="..\..\..\src\Aptison.Booking.Api\Aptison.Booking.Api.csproj" />
    <!-- The OData lists are only answerable with the client's query applied, as the endpoint does. -->
    <ProjectReference Include="..\..\..\..\Synax\src\Libraries\Synax.EntityFrameworkCore.OData\Synax.EntityFrameworkCore.OData.csproj" />
  </ItemGroup>

</Project>
