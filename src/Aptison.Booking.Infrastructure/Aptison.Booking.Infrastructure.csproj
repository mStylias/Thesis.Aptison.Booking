<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <!--
      The only outbound mail transport in this codebase. MailKit rather than
      System.Net.Mail.SmtpClient, which Microsoft's own documentation marks as not recommended for
      new development. Keycloak keeps sending its own mail through its own SMTP configuration.
    -->
    <!--
      4.16.0 or newer, not merely "latest at the time": below it, MailKit is subject to a STARTTLS
      response-injection flaw (GHSA-9j88-vvj5-vhgr) that allows a SASL mechanism downgrade — and
      SmtpOptions.UseStartTls is exactly the path it affects.
    -->
    <PackageReference Include="MailKit" Version="4.18.0" />
    <!-- HybridCache: L1 in-process over L2 Redis, with serialization and stampede protection
         built in. Its L2 is any IDistributedCache, which the Redis package below supplies. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Synax\src\Libraries\Synax.AspNetCore\Synax.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\Synax\src\Libraries\Synax.EntityFrameworkCore\Synax.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\..\Synax\src\Libraries\Synax.EntityFrameworkCore.AspNetCore\Synax.EntityFrameworkCore.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\Synax\src\Libraries\Synax.EntityFrameworkCore.Mapper\Synax.EntityFrameworkCore.Mapper.csproj" />
    <ProjectReference Include="..\..\..\Synax\src\Libraries\Synax.EntityFrameworkCore.Mediator\Synax.EntityFrameworkCore.Mediator.csproj" />
    <!-- IODataExpressionRewriter, for ODataTextFoldingRewriter. Already in the Dockerfile restore stage. -->
    <ProjectReference Include="..\..\..\Synax\src\Libraries\Synax.EntityFrameworkCore.OData\Synax.EntityFrameworkCore.OData.csproj" />
    <!-- Explicit rather than transitive: this assembly declares MapperProfiles of its own, for the
         maps from a provider's shapes into Application's. Already in the Dockerfile restore stage. -->
    <ProjectReference Include="..\..\..\Synax\src\Libraries\Synax.Mapper\Synax.Mapper.csproj" />
    <!-- Infrastructure implements the ports declared in Application\Abstractions, so it depends on
         Application. The dependency is one-way and must stay that way: Application never references
         Infrastructure, which is what keeps the DbContext, Redis and Keycloak out of handlers. -->
    <ProjectReference Include="..\Aptison.Booking.Application\Aptison.Booking.Application.csproj" />
    <ProjectReference Include="..\Aptison.Booking.Domain\Aptison.Booking.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The integration tests register CompanyOwnerProvider, AppUserAuditProvider and
      PostgresConstraintReader themselves rather than copying them: ownership stamping and
      constraint matching are exactly the behaviour a copy would silently let drift.
    -->
    <InternalsVisibleTo Include="Aptison.Booking.Application.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Persistence\Migrations\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Persistence\DataSeeding\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
