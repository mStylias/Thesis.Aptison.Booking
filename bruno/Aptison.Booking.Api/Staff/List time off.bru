meta {
  name: List time off
  type: http
  seq: 12
}

get {
  url: {{base_api_url}}/v1/staff/{{staffMemberId}}/time-off?past=false
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  ~X-Company-Id:
}

docs {
  members:read. Upcoming and current; past=true for what has ended.

  Needs a staff token holding that permission: set access_token in your local Bruno
  environment. A superadmin also sends X-Company-Id to pick the shop.
}
