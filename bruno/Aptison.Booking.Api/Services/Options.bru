get {
  url: {{base_api_url}}/v1/services/options?languageCode=el
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  ~X-Company-Id: 
}

docs {
  services:read. Currency, language codes, visible categories and every staff member. Read once per page visit.

  Needs a staff token holding that permission: set access_token in your local Bruno
  environment. A superadmin also sends X-Company-Id to pick the shop.
}
