meta {
  name: Delete service
  type: http
  seq: 6
}

delete {
  url: {{base_api_url}}/v1/services/{{serviceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  ~X-Company-Id: 
}

docs {
  services:delete. 409 SERVICE_IN_USE once the service is on any appointment, cancelled ones included.

  Needs a staff token holding that permission: set access_token in your local Bruno
  environment. A superadmin also sends X-Company-Id to pick the shop.
}
