# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Docker Compose reads `.env` automatically from the directory it runs in, and
# keycloak-config-cli substitutes these into keycloak/realm-export.json at the
# $(env:...) references before applying the realm.

# Google OAuth credentials for the "Sign in with Google" identity provider.
#
# Get them from https://console.cloud.google.com/apis/credentials:
#   1. Create (or pick) a project, then Create Credentials -> OAuth client ID.
#   2. Application type: Web application.
#   3. Authorized redirect URI, exactly:
#        http://localhost:7030/realms/koureia/broker/google/endpoint
#      That is Keycloak's broker endpoint, not your app's — the browser returns
#      to Keycloak, which then redirects on to the SPA.
#
# Leaving these empty is fine: the whole stack still comes up and every other
# realm setting applies. Only the Google button is inert.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The confidential client secret for the Koureia Node server.
# Generate a different value for each environment. Give the same value to the Node server.
KOUREIA_BFF_CLIENT_SECRET=

# Keycloak accepts only this exact callback URI for the confidential client.
# Change the origin in each deployed environment. Keep the /auth/callback path.
KOUREIA_BFF_REDIRECT_URI=http://localhost:6100/auth/callback

# The email address that becomes the platform's first superadmin.
#
# The very first administrator cannot be granted the role by an existing one, so
# the API grants it from configuration instead: the first time this address signs
# in, that user gets the global `super_admin` role. It fires once, while the user
# row is being created, and only if Keycloak says the address is verified.
#
# Setting it after that person has already signed in does nothing.
#
# Leave it blank to end up with no superadmin at all, which is the right default
# for any machine that is not the one bootstrapping the platform.
SUPERADMIN_EMAIL=

# The API kit from PLACE kit
PLACEKIT_API_KEY=

# Appointment reminders. Blank uses the development values in docker-compose.yml.
# A real environment sets its own once and never changes them: a new secret breaks
# the unsubscribe link in every reminder already sent, and new VAPID keys make
# every customer turn push notifications on again.
#
# The secret is any random string of at least 32 characters, for example the
# output of `openssl rand -base64 48`. Generate the VAPID pair with
# `npx web-push generate-vapid-keys` (base64url, public 65 bytes, private 32).
REMINDERS_UNSUBSCRIBE_SECRET=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
